#!/usr/bin/env bash
# Git hook: rejects commit messages that don't follow Conventional Commits.
# Install: cp topics/11-git/practical/commit-msg .git/hooks/commit-msg && chmod +x .git/hooks/commit-msg
pattern='^(feat|fix|docs|style|refactor|perf|test|build|ci|chore|revert)(\([a-z0-9._-]+\))?!?: .{1,72}$'
first_line=$(head -n 1 "$1")

if [[ "$first_line" =~ ^(Merge|Revert) ]]; then
  exit 0
fi

if ! [[ "$first_line" =~ $pattern ]]; then
  echo "✖ Commit message must follow Conventional Commits, e.g.:"
  echo "    feat(orders): add cancellation endpoint"
  echo "    fix: handle empty cart"
  echo "  got: '$first_line'"
  exit 1
fi
