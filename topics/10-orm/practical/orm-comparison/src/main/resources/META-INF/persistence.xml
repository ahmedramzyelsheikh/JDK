<?xml version="1.0" encoding="UTF-8"?>
<persistence xmlns="https://jakarta.ee/xml/ns/persistence"
             xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
             xsi:schemaLocation="https://jakarta.ee/xml/ns/persistence https://jakarta.ee/xml/ns/persistence/persistence_3_0.xsd"
             version="3.0">

    <!-- Plain JPA bootstrap (no Spring). In Spring Boot, application.properties replaces this file. -->
    <persistence-unit name="bookstore" transaction-type="RESOURCE_LOCAL">
        <class>com.jdk.orm.jpa.Author</class>
        <class>com.jdk.orm.jpa.Book</class>
        <class>com.jdk.orm.jpa.Payment</class>
        <class>com.jdk.orm.jpa.CardPayment</class>
        <class>com.jdk.orm.jpa.BankTransfer</class>
        <exclude-unlisted-classes>true</exclude-unlisted-classes>

        <properties>
            <property name="jakarta.persistence.jdbc.url" value="jdbc:h2:mem:bookstore;DB_CLOSE_DELAY=-1"/>
            <property name="jakarta.persistence.jdbc.user" value="sa"/>
            <property name="jakarta.persistence.jdbc.password" value=""/>
            <!-- generate tables from entities: fine for demos/tests, use Flyway/Liquibase in production -->
            <property name="jakarta.persistence.schema-generation.database.action" value="drop-and-create"/>
            <!-- count SQL statements in tests (N+1 detection) -->
            <property name="hibernate.generate_statistics" value="true"/>
            <property name="hibernate.show_sql" value="false"/>
        </properties>
    </persistence-unit>
</persistence>
