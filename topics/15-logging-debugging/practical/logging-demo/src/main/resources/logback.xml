<?xml version="1.0" encoding="UTF-8"?>
<configuration>

    <!-- human-readable console output; %X{requestId} prints the MDC value -->
    <appender name="CONSOLE" class="ch.qos.logback.core.ConsoleAppender">
        <encoder>
            <pattern>%d{HH:mm:ss.SSS} %-5level [req=%X{requestId:-none}] [%thread] %logger{24} - %msg%n</pattern>
        </encoder>
    </appender>

    <!-- structured JSON lines, one object per event, for log platforms (ELK, Loki, Datadog...) -->
    <appender name="JSON_FILE" class="ch.qos.logback.core.FileAppender">
        <file>target/logs/app.json.log</file>
        <append>false</append>
        <encoder class="ch.qos.logback.classic.encoder.JsonEncoder"/>
    </appender>

    <!-- our code at DEBUG, everything else at INFO -->
    <logger name="com.jdk.logging" level="DEBUG"/>

    <root level="INFO">
        <appender-ref ref="CONSOLE"/>
        <appender-ref ref="JSON_FILE"/>
    </root>
</configuration>
